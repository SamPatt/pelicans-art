  "methods": [
    {
      "id": "minimal",
      "title": "Minimal contract",
      "instruction": "Create an expressive, readable vector asset for an absurd comedy theater. Choose the visual treatment yourself. Output only the SVG."
    },
    {
      "id": "current",
      "title": "Current browser recipe",
      "instruction": "Use the current browser generation prompt below, retaining its aesthetic guidance wherever compatible with the shared contract."
    },
    {
      "id": "art-direction",
      "title": "Art direction",
      "instruction": "Design this as a characterful theatrical vector illustration. Establish one memorable silhouette and a clear focal feature. Use deliberate asymmetry where it serves the brief, controlled contrast, no more than six main colors, and generous separation between important shapes. Avoid tiny decorative marks that vanish at phone size. Favor a few expressive contours over stacks of generic circles. Preserve every required object and relationship. Output only the SVG."
    },
    {
      "id": "layout-plan",
      "title": "Scene/component/layout plan",
      "instruction": "Before drawing, write a compact visible plan (at most 120 words): required objects, their component shapes, approximate bounding boxes, overlaps and front-to-back layer order. Check that connected parts actually touch and important objects remain visible. Then create the SVG from that plan using editable primitives and short paths. Do not add new story objects beyond the brief. Save the plan separately; the SVG file contains only SVG."
    },
    {
      "id": "reference",
      "title": "Same-category SVG example",
      "instruction": "Use the supplied same-category SVG as an example of editable structure, shape vocabulary and visual coherence. Draw the requested new subject; do not copy the example subject, its distinctive props, or proportions that conflict with the brief. Output only the SVG."
    },
    {
      "id": "agent-current",
      "title": "Current agent guide",
      "instruction": "Follow the supplied current agent SVG authoring guide and character guide where compatible with the shared study contract. The study runner handles rendering after your first output; do not render this first-pass candidate."
    }
  ],
