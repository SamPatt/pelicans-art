# pelicans.art local server configuration
# Copy this to .env and customize for your setup

# =============================================================================
# Server Settings
# =============================================================================
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# Optional extra browser origins, comma separated (same-origin is allowed).
# Required for a private HTTPS reverse proxy; wildcards are not accepted.
# CORS_ORIGIN=https://your-domain.com
CORS_ORIGIN=

# =============================================================================
# OpenClaw Connection (for AI-assisted sprite/skit generation)
# =============================================================================

# OpenClaw Gateway URL
# Local:  http://127.0.0.1:18789
# Remote: https://your-vps.tailnet.ts.net:18789 (via Tailscale)
OPENCLAW_URL=http://127.0.0.1:18789

# Gateway authentication token
# Generate with: openclaw doctor --generate-gateway-token
OPENCLAW_TOKEN=your-gateway-token-here

# Agent ID to use for generation requests
# Use an existing agent or create a dedicated one
OPENCLAW_AGENT_ID=skitkit

# =============================================================================
# TTS Connection (for speech synthesis)
# =============================================================================

# Pocket TTS server URL
# Local:  http://127.0.0.1:8001
# Remote: http://100.x.x.x:8001 (Tailscale IP)
TTS_URL=http://127.0.0.1:8001

# Optional server-owned Piper relay credential, only sent to this exact URL.
# HERMES_TTS_URL=https://your-private-host.example/tts
# HERMES_TTS_AUTH_HEADER=X-Watch-Token
# HERMES_TTS_TOKEN=

# Optional companion Editor chat; requires an already configured Hermes with ACP.
# Keep this server on loopback or behind authenticated private access.
HERMES_EDITOR_ENABLED=0
# HERMES_EDITOR_COMMAND=/absolute/path/to/hermes
# HERMES_EDITOR_CWD=/absolute/project/directory
# HERMES_EDITOR_ORIGIN=https://your-private-host.example
# Optional server-local JSON containing a CLI tts object; defaults to pinned Pocket at TTS_URL/tts.
# HERMES_EDITOR_TTS_CONFIG=/absolute/path/to/editor-tts.json
