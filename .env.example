# SkitKit Server Configuration
# Copy this to .env and customize for your setup

# =============================================================================
# Server Settings
# =============================================================================
PORT=3003
DATA_DIR=./data

# CORS - set to specific origin in production
# CORS_ORIGIN=https://your-domain.com
CORS_ORIGIN=*

# =============================================================================
# OpenClaw Connection (for AI-assisted sprite/skit generation)
# =============================================================================

# OpenClaw Gateway URL
# Local:  http://127.0.0.1:18789
# Remote: https://your-vps.tailnet.ts.net:18789 (via Tailscale)
OPENCLAW_URL=http://127.0.0.1:18789

# Gateway authentication token
# Generate with: openclaw doctor --generate-gateway-token
OPENCLAW_TOKEN=your-gateway-token-here

# Agent ID to use for generation requests
# Use an existing agent or create a dedicated one
OPENCLAW_AGENT_ID=skitkit

# =============================================================================
# TTS Connection (for speech synthesis)
# =============================================================================

# Pocket TTS server URL
# Local:  http://127.0.0.1:8001
# Remote: http://100.x.x.x:8001 (Tailscale IP)
TTS_URL=http://127.0.0.1:8001
